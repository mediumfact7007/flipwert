PORT=8080
# Safe default. Change to "production" only for an explicitly approved live deployment.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
KEEPA_API_KEY=
# Configure only after the provider/feed owner has approved price use and
# republication. Credentials remain server-side and must never enter the APK.
BUYBACK_SOURCE_URL=
BUYBACK_SOURCE_TOKEN=
BUYBACK_SOURCE_TIMEOUT_MS=6000
# Short exact-query cache; capped by the server at five minutes.
BUYBACK_SOURCE_CACHE_TTL_MS=60000
BUYBACK_SOURCE_POLICY_ACK=
# Set only to the fingerprint returned by a successful representative
# npm run verify:buyback-source matrix for this exact rights configuration.
BUYBACK_SOURCE_ACTIVATION_FINGERPRINT=
# JSON array; keep one independently reviewed rights record per provider.
# Each record must include exact feed_hosts and offer_hosts (hostnames only,
# no schemes, paths or wildcards). See docs/buyback-source-approval.example.json.
BUYBACK_SOURCE_APPROVALS_JSON=[]
